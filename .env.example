# Required ---------------------------------------------------------------

# mainnet | regtest
NETWORK=regtest

# JDBC-style URL is fine too; Hikari + the SDK both accept jdbc:postgresql://…
# as well. The form below is what `docker-compose.yml` exposes locally.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/sdk_mu_demo

# Seed-derivation input. HMAC-SHA512(MASTER_SECRET, user_id) → 64-byte entropy
# per wallet. Use a long, high-entropy value in prod. Hex or ASCII both work.
MASTER_SECRET=change-me-to-a-long-random-string

# Shared HMAC-SHA256 secret given to the Spark SSP at webhook registration.
# Each delivery signs the raw body with this; the handler verifies before
# acting. One value across all users in v1.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Where this server is reachable from the public internet. Used to build the
# per-user webhook URL given to the SSP at registration. Locally: an ngrok
# or cloudflared tunnel URL — the SSP needs to reach you.
PUBLIC_BASE_URL=https://localhost:8080

# Breez partner API key. Required on mainnet (JWT auth to Spark operators).
# Leave empty on regtest.
BREEZ_API_KEY=

# Signer -----------------------------------------------------------------

# seed | turnkey. Deployment-wide. 'seed' derives per-user wallet seeds from
# MASTER_SECRET in-process. 'turnkey' keeps keys in Turnkey's enclave: each
# POST /users creates a wallet there, and signing runs through the Turnkey
# API. Users record the mode they were provisioned with; serving a user
# under the other mode fails with signer_mismatch rather than presenting an
# empty wallet under different keys.
SIGNER=seed

# Required when SIGNER=turnkey. One organization-level API keypair stamps
# all requests. Create a P-256 key (the Turnkey console default) — the
# in-app stamper signs with plain JCA, and the SDK auto-detects the curve.
# TURNKEY_ORG_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_BASE_URL=https://api.turnkey.com

# Optional ---------------------------------------------------------------

PORT=8080

# Comma-separated origins for CORS. Empty disables CORS. Wired in Phase 2.
CORS_ORIGINS=

LOG_LEVEL=info

# EnvFilter for the SDK's Rust logs, bridged into the app log stream. Syntax
# matches RUST_LOG, e.g. "info" or "info,spark=debug,breez_sdk_spark=debug".
# This is the only gate on SDK log verbosity (logback passes them through).
SDK_LOG_FILTER=info

# Max connections in the SDK's shared Postgres pool. Unset = SDK default
# (num_cpus * 4), which is just 4 on a 1-CPU host. Set explicitly so the pool
# size doesn't track the box's core count.
# SDK_PG_MAX_POOL_SIZE=20

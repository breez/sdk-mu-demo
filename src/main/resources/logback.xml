<configuration>
    <!--
      Two appenders, selected at runtime by LOG_FORMAT (`pretty` | `json`).
      Default `pretty` for local; set `json` in prod for structured ingest.
    -->
    <property name="LOG_APPENDER" value="${LOG_FORMAT:-pretty}"/>

    <appender name="pretty" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <!--
      SDK (Rust) logs arrive via the initLogging bridge. Pin wide-open so
      logback never re-filters them; SDK_LOG_FILTER (EnvFilter) is the only
      gate on SDK verbosity.
    -->
    <logger name="breez_sdk" level="TRACE"/>

    <root level="${LOG_LEVEL:-info}">
        <appender-ref ref="${LOG_APPENDER}"/>
    </root>
</configuration>
